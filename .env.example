# =========================================================
# Dulce Rinconcito — Variables de entorno
# =========================================================
# Copia este archivo como `.env` y rellena los valores.
#
# En LOCAL (XAMPP, Laragon, etc.) se usa este archivo.
# En HOSTINGER normalmente NO subes el .env: configura las
# mismas variables desde el panel del hosting y se exponen
# automáticamente vía getenv() / $_SERVER.
# =========================================================

# -------- Entorno --------
# production | development
APP_ENV=production
APP_DEBUG=false

# -------- Marca --------
APP_NAME="Dulce Rinconcito"
APP_TAGLINE="Pastelería y repostería artesanal"

# -------- Base de datos --------
# Opciones: sqlite | mysql
DB_DRIVER=mysql

# MySQL (Hostinger suele usar 'localhost' como host)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_dulce      # pon aquí el nombre real de tu BD
DB_USER=u123456789_roy        # pon aquí tu usuario real
DB_PASS=TuPasswordSeguro123   # pon aquí tu contraseña real
DB_CHARSET=utf8mb4

# (Opcional) Si DB_DRIVER=sqlite, ruta al archivo SQLite
# SQLITE_PATH=

# -------- Zona horaria --------
APP_TIMEZONE=America/Mexico_City

# -------- Sesión --------
SESSION_NAME=reposteria_sess